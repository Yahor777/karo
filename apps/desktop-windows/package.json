{
  "name": "@ai-agent-orchestrator/desktop-windows",
  "version": "0.0.0",
  "private": true,
  "description": "Windows Desktop App (primary product). Tauri shell + renderer bridge.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "dev": "tauri dev",
    "dev:renderer": "vite",
    "build": "tsc -b --noEmit && vite build",
    "build:tauri": "tauri build",
    "build:installer": "tauri build --bundles msi,nsis",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest --run",
    "mcp:ui": "tsx mcp/karo-ui-mcp-server.ts",
    "gui:check": "tsx mcp/run-all-gui-scenarios.ts",
    "gui:check:headed": "tsx mcp/run-all-gui-scenarios.ts --headed",
    "gui:check:desktop": "tsx mcp/run-desktop-smoke.ts",
    "gui:check:tauri-runtime": "tsx mcp/run-tauri-runtime-proof.ts",
    "gui:screenshots": "tsx mcp/run-all-gui-scenarios.ts --screenshots",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@ai-agent-orchestrator/client-sdk": "workspace:*",
    "@ai-agent-orchestrator/shared-core": "workspace:*",
    "@ai-agent-orchestrator/shared-ui": "workspace:*",
    "@ai-agent-orchestrator/validation": "workspace:*",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tauri-apps/cli": "^2.0.0",
    "jsdom": "^24.0.0",
    "playwright": "^1.60.0",
    "tsx": "^4.22.3",
    "typescript": "^5.4.0",
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "zod": "^4.4.3"
  }
}
