{
  "name": "@ai-agent-orchestrator/web",
  "version": "0.0.0",
  "private": true,
  "description": "Web App (secondary interface). Reuses shared core, shared UI and client SDK.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview --port 5173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest --run"
  },
  "dependencies": {
    "@ai-agent-orchestrator/shared-core": "workspace:*",
    "@ai-agent-orchestrator/shared-ui": "workspace:*",
    "@ai-agent-orchestrator/client-sdk": "workspace:*",
    "@ai-agent-orchestrator/validation": "workspace:*"
  },
  "devDependencies": {
    "vite": "^5.4.0",
    "vitest": "^2.0.0",
    "jsdom": "^24.0.0"
  }
}
