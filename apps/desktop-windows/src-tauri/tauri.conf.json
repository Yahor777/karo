{
  "productName": "AI Agent Orchestrator",
  "version": "0.0.0",
  "identifier": "com.ai-agent-orchestrator.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "vite",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Agent Orchestrator",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: tauri: http://ipc.localhost"
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "AI Agent Orchestrator",
    "homepage": "https://example.invalid/ai-agent-orchestrator",
    "category": "DeveloperTool",
    "shortDescription": "AI Agent Orchestrator desktop app",
    "longDescription": "Desktop-first AI Agent Orchestrator (Windows primary, Web secondary).",
    "copyright": "Copyright (c) AI Agent Orchestrator contributors",
    "windows": {
      "wix": {
        "language": ["en-US"],
        "upgradeCode": "00000000-0000-0000-0000-000000000000"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://example.invalid/updates/{{target}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": "REPLACE_WITH_BASE64_TAURI_PUBLIC_KEY"
    }
  }
}
