{
  "name": "@ai-agent-orchestrator/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Backend services: API gateway, Auth, Settings, Model Catalog, Orchestrator, Agent Runtime, Web Search, Trace Bus, Artifact Store, Persistence, Secrets, Fallback Manager.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "prebuild:dev": "tsc -b",
    "dev": "tsc -b && node ./dist/devServer.js",
    "dev:watch": "tsc -b --watch",
    "test": "vitest --run"
  },
  "dependencies": {
    "@ai-agent-orchestrator/shared-core": "workspace:*",
    "@ai-agent-orchestrator/validation": "workspace:*",
    "@ai-agent-orchestrator/agent-contracts": "workspace:*"
  }
}
